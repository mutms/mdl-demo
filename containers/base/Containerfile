# mdl-demo — self-contained Moodle/MuTMS demo image.
#
# Debian trixie with mdl-demo's own Go init as PID 1: it starts and
# supervises PostgreSQL, php-fpm and Apache (port 8080) and serves the
# management UI (port 8081). No systemd on purpose — a standard OCI
# runtime gives PID 1 no CAP_SYS_ADMIN and often a read-only cgroup tree,
# which systemd cannot boot under (the WSL containers preview proved this
# terminally), while the Go init needs no capabilities, no cgroups and no
# tmpfs. The SAME run command therefore works on rootful podman,
# Apple `container` and WSL containers:
#
#   <runtime> run -d --name demo \
#       -p 127.0.0.1:8080:8080 -p 127.0.0.1:8081:8081 \
#       -e MDL_DEMO_PASSWORD=... mdl-demo
#
# Build from the REPO ROOT (the build stage copies go/):
#   sudo podman build -t mdl-demo -f containers/base/Containerfile .

# ---------------------------------------------------------------------------
# Stage 1: build mudev + mdl-demo. Runs on the build host's native arch and
# cross-compiles for $TARGETARCH, so a multi-arch build never compiles Go
# under qemu. GOTOOLCHAIN=local: trixie's golang-go (1.24) or a legible
# failure, never a silent 210 MB toolchain download.
FROM --platform=$BUILDPLATFORM debian:trixie AS build
ARG TARGETARCH
ARG MUDEV_REF=main
ARG VERSION=dev

RUN apt-get update \
    && apt-get install -y --no-install-recommends golang-go git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOFLAGS=-trimpath

RUN git clone --depth 1 --branch "$MUDEV_REF" https://github.com/mutms/mudev /src/mudev \
    && cd /src/mudev/go \
    && GOARCH=$TARGETARCH go build -o /out/mudev ./cmd/mudev

COPY go/ /src/mdl-demo/
RUN cd /src/mdl-demo \
    && GOARCH=$TARGETARCH go build -ldflags "-X main.version=$VERSION" -o /out/mdl-demo ./cmd/mdl-demo

# ---------------------------------------------------------------------------
# Stage 2: the runtime image.
#
# The explicit $TARGETPLATFORM is LOAD-BEARING: stage 1 pulls debian:trixie
# for the build host's arch, and a bare `FROM debian:trixie` here would
# resolve to that already-present local image by name — producing an "arm64"
# image whose apt layers are all x86-64 (Exec format error on PID 1).
FROM --platform=$TARGETPLATFORM debian:trixie

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl git ca-certificates gnupg2 lsb-release apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# PHP 8.3 from the Sury repo (keyring style), Apache, PostgreSQL — one apt
# pass. Moodle-required PHP extensions per mpd's runtime build.
RUN curl -fsSL https://packages.sury.org/php/apt.gpg \
        | gpg --dearmor -o /usr/share/keyrings/sury-php.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" \
        > /etc/apt/sources.list.d/sury-php.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        apache2 postgresql postgresql-client \
        php8.3-cli php8.3-fpm php8.3-curl php8.3-gd php8.3-intl php8.3-mbstring \
        php8.3-pgsql php8.3-soap php8.3-xml php8.3-zip php8.3-opcache \
    && rm -rf /var/lib/apt/lists/*

# Moodle's php.ini requirements (fpm + cli), values from mpd's runtime.
RUN for sapi in fpm cli; do \
        printf '%s\n' \
            'max_input_vars = 10000' \
            'upload_max_filesize = 200M' \
            'post_max_size = 206M' \
            'zend.exception_ignore_args = On' \
            > /etc/php/8.3/$sapi/conf.d/99-moodle.ini; \
    done

# Apache: PHP via FPM socket, Moodle 5 router needs rewrite. Port 8080 only.
# The placeholder vhost is swapped for the real Moodle vhost by mdl-demo at
# install time (the docroot depends on the Moodle version's tree layout).
COPY containers/base/assets/placeholder/ /var/www/placeholder/
COPY containers/base/assets/000-placeholder.conf /etc/apache2/sites-available/
RUN a2enmod proxy_fcgi rewrite setenvif \
    && a2dissite 000-default \
    && a2ensite 000-placeholder \
    && sed -i 's/^Listen 80$/Listen 8080/' /etc/apache2/ports.conf \
    && echo 'ServerName localhost' > /etc/apache2/conf-available/servername.conf \
    && a2enconf servername

# Demo-speed tweak from mpd: bounded loss on power cut, no corruption.
# (Deliberately NOT full_page_writes=off — that risks torn pages.)
RUN printf 'synchronous_commit = off\n' \
        > "$(ls -d /etc/postgresql/*/main/conf.d)/demo.conf"

COPY --from=build /out/mudev /out/mdl-demo /usr/bin/

# Recipe + plugin catalogues at mudev's default paths. Shallow, but with .git
# kept so a running container can `git pull` fresh recipes.
RUN git clone --depth 1 https://github.com/mutms/mdl-plugins /srv/extra/mdl-plugins \
    && git clone --depth 1 https://github.com/mutms/mdl-recipes /srv/extra/mdl-recipes \
    && mkdir -p /srv/projects/demo /srv/data /etc/mdl-demo

# Links the ghcr.io package to the repo (and its README to the package page).
LABEL org.opencontainers.image.source=https://github.com/mutms/mdl-demo \
      org.opencontainers.image.description="Throwaway Moodle/MuTMS demo sites in one command" \
      org.opencontainers.image.licenses=GPL-3.0-or-later

EXPOSE 8080 8081

# mdl-demo init as PID 1: supervises the services, reaps orphans, and turns
# SIGTERM (the default stop signal) into an ordered shutdown.
ENTRYPOINT ["/usr/bin/mdl-demo", "init"]
