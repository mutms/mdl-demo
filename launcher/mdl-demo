#!/usr/bin/env bash
# mdl-demo — run Moodle/MuTMS demo containers on macOS (Apple container).
#
#   mdl-demo create [NNNN] [--name="Fancy demo"] [--password=secret] [--tag=v0.1.2]
#   mdl-demo start|stop|delete [NNNN]
#   mdl-demo list
#
# NNNN is the demo's number: the port of its management console. The
# container is named mdl-demo-NNNN, the console is http://localhost:NNNN and
# the Moodle site is on the next port, NNNN+1. Without a number, 8081 (and
# 8082 for the site). Pick another number to run several demos side by side.
#
# Inside the container the ports are fixed (8081 console, 8082 site); this
# script maps NNNN and NNNN+1 onto them and passes the number in as
# MDL_DEMO_PORT, so the console knows its own address.
set -euo pipefail

IMAGE="${MDL_DEMO_IMAGE:-ghcr.io/mutms/mdl-demo}"

usage() {
    cat <<EOF
Usage: mdl-demo <command> [NNNN] [options]

Commands:
  create [NNNN]   create and start a new demo (console on port NNNN, default 8081)
  start  [NNNN]   start a stopped demo
  stop   [NNNN]   stop a running demo (the site and its data are kept)
  delete [NNNN]   stop and remove a demo, including its site and data
  list            show all demos

Options for create:
  --name="..."    label shown in the console heading, also the Moodle site name
  --password=...  console password (otherwise the console asks on first visit)
  --tag=...       image version, e.g. --tag=v0.1.2 (default: latest)

The demo's number NNNN is the port of its console: http://localhost:NNNN.
The Moodle site is on the next port, NNNN+1.
EOF
}

die() { echo "mdl-demo: $*" >&2; exit 1; }

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in help|--help|-h) usage; exit 0 ;; esac

# Two checks, two different fixes: the CLI is not installed at all, or it is
# installed but its background service is not running (the usual state right
# after installation or a reboot). `ls` is the cheapest call that needs the
# service. Help text goes to the user before any command is attempted.
if ! command -v container >/dev/null 2>&1; then
    cat >&2 <<EOF
mdl-demo: Apple container is not installed.

  It is Apple's container tool for macOS 15 or newer on Apple silicon:
  download the installer package from
      https://github.com/apple/container/releases
  open it, then in a new terminal window run
      container system start
  and try this command again.
EOF
    exit 1
fi
if ! container ls >/dev/null 2>&1; then
    cat >&2 <<EOF
mdl-demo: Apple container is installed but not running.

  Start its background service with
      container system start
  and try this command again.
EOF
    exit 1
fi


port=8081 name="" password="" tag="latest" positional=0
for arg in "$@"; do
    case "$arg" in
        --name=*)     name="${arg#--name=}" ;;
        --password=*) password="${arg#--password=}" ;;
        --tag=*)      tag="${arg#--tag=}" ;;
        --help|-h)    usage; exit 0 ;;
        --name|--password|--tag)
            die "$arg needs a value with '=': $arg=..." ;;
        -*)           die "unknown option '$arg' (see 'mdl-demo help')" ;;
        *)
            [[ "$arg" =~ ^[0-9]+$ ]] \
                || die "unexpected argument '$arg' — quote names with spaces: --name=\"My demo\""
            positional=$((positional + 1))
            [ "$positional" -eq 1 ] || die "only one demo number allowed"
            port="$arg" ;;
    esac
done
[ "$port" -ge 1024 ] && [ "$port" -le 65534 ] \
    || die "the demo number must be a port between 1024 and 65534 (got '$port')"

cname="mdl-demo-$port"
site=$((port + 1))

exists() { container inspect "$cname" >/dev/null 2>&1; }

case "$cmd" in
    create)
        exists && die "$cname already exists — 'mdl-demo start $port' starts it, 'mdl-demo delete $port' removes it"
        args=(run -d --name "$cname" -e "MDL_DEMO_PORT=$port")
        [ -n "$name" ] && args+=(-e "MDL_DEMO_NAME=$name")
        [ -n "$password" ] && args+=(-e "MDL_DEMO_PASSWORD=$password")
        args+=(-p "127.0.0.1:$port:8081" -p "127.0.0.1:$site:8082" "$IMAGE:$tag")
        container "${args[@]}" >/dev/null
        echo "created $cname${name:+ ($name)}"
        echo "set up your demo site in the console: http://localhost:$port"
        [ -n "$password" ] || echo "the console asks you to choose its password on the first visit"
        ;;
    start)
        exists || die "$cname does not exist — 'mdl-demo create $port' makes it"
        container start "$cname" >/dev/null
        echo "started $cname — console: http://localhost:$port"
        ;;
    stop)
        exists || die "$cname does not exist"
        container stop "$cname" >/dev/null
        echo "stopped $cname (start it again with 'mdl-demo start $port')"
        ;;
    delete)
        exists || die "$cname does not exist"
        container stop "$cname" >/dev/null 2>&1 || true
        container rm "$cname" >/dev/null
        echo "deleted $cname and its demo site"
        ;;
    list)
        container ls -a | awk 'NR == 1 || $1 ~ /^mdl-demo-/'
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        die "unknown command '$cmd' (see 'mdl-demo help')"
        ;;
esac
