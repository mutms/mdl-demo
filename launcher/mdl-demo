#!/usr/bin/env bash
# mdl-demo - run Moodle/MuTMS demo containers on macOS (Apple container).
# Project, docs and the latest version of this script:
#   https://github.com/mutms/mdl-demo   (see MACOS.md)
#
#   mdl-demo create [NNNN] [--name="Fancy demo"] [--tag=v0.1.2] [--open]
#   mdl-demo start|stop|delete [NNNN]
#   mdl-demo list
#   mdl-demo gc
#   mdl-demo install|uninstall   (print setup/removal steps; change nothing)
#
# NNNN is the demo's number: the port of its management console. The
# container is named mdl-demo-NNNN, the console is http://127.0.0.1:NNNN and
# the Moodle site is on the next port, NNNN+1. Without a number, 8081 (and
# 8082 for the site). Pick another number to run several demos side by side.
#
# Inside the container the ports are fixed (8081 console, 8082 site); this
# script maps NNNN and NNNN+1 onto them and passes the number in as
# MDL_DEMO_PORT, so the console knows its own address.
set -euo pipefail

IMAGE="${MDL_DEMO_IMAGE:-ghcr.io/mutms/mdl-demo}"

usage() {
    cat <<EOF
mdl-demo - run throwaway Moodle/MuTMS demo sites on macOS, in a container.

Usage: mdl-demo <command> [NNNN] [options]

Commands:
  create [NNNN]   create and start a new demo (console on port NNNN, default 8081)
  start  [NNNN]   start a stopped demo
  stop   [NNNN]   stop a running demo (the site and its data are kept)
  delete [NNNN]   stop and remove a demo, including its site and data
  list            show all demos
  gc [--all]      reclaim disk from unused images (never touches containers);
                  --all also removes images no demo is using (e.g. the demo image)
  install         print how to set up mdl-demo on this system (changes nothing)
  uninstall       print how to remove mdl-demo from this system (changes nothing)

Options for create:
  --name="..."    label shown in the console heading, also the Moodle site name
  --tag=...       image version, e.g. --tag=v0.1.2 (default: latest)

Options for create and start:
  --open          open the console in your browser once it answers

The demo's number NNNN is the port of its console: http://127.0.0.1:NNNN.
The Moodle site is on the next port, NNNN+1.

What this is, the full guide, and the latest version of this script:
  https://github.com/mutms/mdl-demo   (see MACOS.md)
EOF
}

die() { echo "mdl-demo: $*" >&2; exit 1; }

install_help() {
    cat <<EOF
Setting up mdl-demo on macOS - these are just the steps, nothing is changed.

  1. Install Apple container (macOS 26 or newer, Apple silicon), see
        https://github.com/apple/container/releases
     open it, then in a terminal run
        container system start

  2. Keep this helper somewhere on your PATH so you can run it from anywhere:
        mkdir -p ~/bin && cp "$0" ~/bin/mdl-demo && chmod +x ~/bin/mdl-demo
     (make sure ~/bin is on your PATH)

  3. Start your first demo:
        mdl-demo create --open

  4. Later upgrade Apple container to the latest version using
        https://github.com/apple/container#upgrade-or-downgrade

EOF
}

uninstall_help() {
    cat <<EOF
Removing mdl-demo on macOS - these are just the steps, nothing is changed.

  1. Delete your demos (this removes their sites and data):
        mdl-demo list
        mdl-demo delete NNNN         # for each demo the list shows

  2. Reclaim the disk the images used:
        mdl-demo gc                              # unused layers
        container image rm ghcr.io/mutms/mdl-demo  # the demo image itself

  3. Remove this helper:
        rm ~/bin/mdl-demo            # wherever you put it

  4. Optional: uninstall Apple container itself using
        https://github.com/apple/container#uninstall
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
    help|--help|-h) usage; exit 0 ;;
    install)        install_help; exit 0 ;;
    uninstall)      uninstall_help; exit 0 ;;
esac

# Two checks, two different fixes: the CLI is not installed at all, or it is
# installed but its background service is not running (the usual state right
# after installation or a reboot). `ls` is the cheapest call that needs the
# service. Help text goes to the user before any command is attempted.
if ! command -v container >/dev/null 2>&1; then
    echo "mdl-demo: Apple container is not installed - run 'mdl-demo install' for the setup steps." >&2
    exit 1
fi
if ! container ls >/dev/null 2>&1; then
    # Installed but its background service is not up (the usual state right
    # after installation or a reboot) - just start it and carry on.
    echo "mdl-demo: starting Apple container's background service..." >&2
    container system start >/dev/null 2>&1 || true
    if ! container ls >/dev/null 2>&1; then
        cat >&2 <<EOF
mdl-demo: Apple container is installed but would not start.

  Start it yourself with
      container system start
  then run your mdl-demo command again.
EOF
        exit 1
    fi
fi


port=8081 name="" tag="latest" open=0 all=0 positional=0
for arg in "$@"; do
    case "$arg" in
        --name=*)  name="${arg#--name=}" ;;
        --tag=*)   tag="${arg#--tag=}" ;;
        --open)    open=1 ;;
        --all)     all=1 ;;
        --help|-h) usage; exit 0 ;;
        --name|--tag)
            die "$arg needs a value with '=': $arg=..." ;;
        -*)           die "unknown option '$arg' (see 'mdl-demo help')" ;;
        *)
            [[ "$arg" =~ ^[0-9]+$ ]] \
                || die "unexpected argument '$arg' - quote names with spaces: --name=\"My demo\""
            positional=$((positional + 1))
            [ "$positional" -eq 1 ] || die "only one demo number allowed"
            port="$arg" ;;
    esac
done
[ "$port" -ge 1024 ] && [ "$port" -le 65534 ] \
    || die "the demo number must be a port between 1024 and 65534 (got '$port')"

cname="mdl-demo-$port"
site=$((port + 1))

exists() { container inspect "$cname" >/dev/null 2>&1; }

# open_console waits for the console to answer, then hands it to the browser.
# The container is running before the console is listening: `container run`
# returns once the init has been started, and the init opens the port a moment
# later - so a bare `open` can win the race and land on a connection error.
open_console() {
    url="http://127.0.0.1:$1"
    printf 'waiting for the console'
    for _ in $(seq 60); do
        if curl -fsS -o /dev/null "$url" 2>/dev/null; then
            printf '\n'
            open "$url"
            return
        fi
        printf '.'
        sleep 0.5
    done
    printf '\n'
    echo "mdl-demo: the console has not answered yet - open $url when it does" >&2
}

case "$cmd" in
    create)
        exists && die "$cname already exists - 'mdl-demo start $port' starts it, 'mdl-demo delete $port' removes it"
        args=(run -d --name "$cname" -e "MDL_DEMO_PORT=$port")
        [ -n "$name" ] && args+=(-e "MDL_DEMO_NAME=$name")
        args+=(-p "127.0.0.1:$port:8081" -p "127.0.0.1:$site:8082" "$IMAGE:$tag")
        container "${args[@]}" >/dev/null
        echo "created $cname${name:+ ($name)}"
        echo "set up your demo site in the console: http://127.0.0.1:$port"
        if [ "$open" -eq 1 ]; then open_console "$port"; fi
        ;;
    start)
        exists || die "$cname does not exist - 'mdl-demo create $port' makes it"
        container start "$cname" >/dev/null
        echo "started $cname - console: http://127.0.0.1:$port"
        if [ "$open" -eq 1 ]; then open_console "$port"; fi
        ;;
    stop)
        exists || die "$cname does not exist"
        container stop "$cname" >/dev/null
        echo "stopped $cname (start it again with 'mdl-demo start $port')"
        ;;
    delete)
        exists || die "$cname does not exist"
        container stop "$cname" >/dev/null 2>&1 || true
        container rm "$cname" >/dev/null
        echo "deleted $cname and its demo site"
        ;;
    list)
        container ls -a | awk 'NR == 1 || $1 ~ /^mdl-demo-/'
        ;;
    gc)
        if [ "$all" -eq 1 ]; then
            echo "removing all unused images (they re-download when a demo needs them)..."
            container image prune --all
        else
            echo "removing unused (dangling) images..."
            container image prune
            echo "still low on disk? 'mdl-demo gc --all' removes unused demo images too."
        fi
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        die "unknown command '$cmd' (see 'mdl-demo help')"
        ;;
esac
