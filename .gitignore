.DS_Store
.idea/
/bin/
/dist/
/assets/backups/*.mdb
/temp/
# Offline-demo git mirrors (dev/prepare-offline-build.sh) - gigabytes, never
# committed. Kept out of git status so they persist between builds for fast
# rebuilds. NB: this also hides them from github-publish.sh's dirty-tree check -
# that script has its own guard against publishing an offline build.
/assets/repos/*
!/assets/repos/README.md
# Poster content (dev/presenter customization) - the stock repo ships only the
# README contract; a fork drops title.html/blurb.html/page.html/logo.svg into its
# own build. Keeps the sample out of the official image.
/assets/poster/*
!/assets/poster/README.md
# Per-tool scratch: any dev/<tool>/ drops its regenerable junk (frames, encodes,
# working dirs) under its own temp/. One rule so it never accumulates here.
/dev/*/temp/
