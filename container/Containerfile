# mdl-demo — self-contained Moodle/MuTMS demo image.
#
# Debian trixie with mdl-demo's own Go init as PID 1: it starts and
# supervises PostgreSQL, php-fpm and Apache (port 8082) and serves the
# management console (port 8081). Outside, the console port is the demo's
# identity (MDL_DEMO_PORT, default 8081) and the site is always on the next
# one, so the mapping is NNNN:8081 and NNNN+1:8082. No systemd on purpose —
# a standard OCI runtime gives PID 1 no CAP_SYS_ADMIN and often a read-only
# cgroup tree,
# which systemd cannot boot under (the WSL containers preview proved this
# terminally), while the Go init needs no capabilities, no cgroups and no
# tmpfs. The SAME run command therefore works on rootful podman,
# Apple `container` and WSL containers:
#
#   <runtime> run -d --name mdl-demo-8081 \
#       -p 127.0.0.1:8081:8081 -p 127.0.0.1:8082:8082 mdl-demo
#
# Build from the REPO ROOT (the build stage copies go/):
#   sudo podman build -t mdl-demo -f container/Containerfile .

# ---------------------------------------------------------------------------
# Stage 1: build mudev + mdl-demo. Runs on the build host's native arch and
# cross-compiles for $TARGETARCH, so a multi-arch build never compiles Go
# under qemu. Upstream Go from go.dev on plain pinned Debian — never
# Debian's golang-go; go.mod picks the compiler.
FROM --platform=$BUILDPLATFORM debian:trixie AS build
ARG TARGETARCH
ARG MUDEV_REF=main
ARG VERSION=dev

RUN apt-get update \
    && apt-get install -y --no-install-recommends git wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pinned with checksums — bump both together.
ARG GO_VERSION=1.27.1
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) sha256=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445 ;; \
        arm64) sha256=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec ;; \
        *) echo "unsupported build architecture: $arch" >&2; exit 1 ;; \
    esac; \
    wget -qO /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz"; \
    echo "$sha256  /tmp/go.tgz" | sha256sum -c --quiet; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz; \
    ln -s /usr/local/go/bin/go /usr/local/bin/go

ENV CGO_ENABLED=0 GOFLAGS=-trimpath

# Stamp mudev's version the way its own Makefile does — `git describe` reads
# the nearest tag, so `mudev --version` in the image identifies the exact build
# (and its compiled-in release flavours), the way it does everywhere else. A
# full clone, not --depth 1: describe needs the tag in history, and the mudev
# repo is small source, so the extra history is cheap.
RUN git clone --branch "$MUDEV_REF" https://github.com/mutms/mudev /src/mudev \
    && cd /src/mudev \
    && MUDEV_VERSION="$(git describe --tags --always --dirty 2>/dev/null || echo dev)" \
    && cd go \
    && GOARCH=$TARGETARCH go build -ldflags "-X main.version=$MUDEV_VERSION" -o /out/mudev ./cmd/mudev

COPY go/ /src/mdl-demo/
RUN cd /src/mdl-demo \
    && GOARCH=$TARGETARCH go build -ldflags "-X main.version=$VERSION" -o /out/mdl-demo ./cmd/mdl-demo

# ---------------------------------------------------------------------------
# Stage 2: the runtime image.
#
# The explicit $TARGETPLATFORM is LOAD-BEARING: stage 1 pulls debian:trixie
# for the build host's arch, and a bare `FROM debian:trixie` here would
# resolve to that already-present local image by name — producing an "arm64"
# image whose apt layers are all x86-64 (Exec format error on PID 1).
FROM --platform=$TARGETPLATFORM debian:trixie

# dist-upgrade: these containers live like small VMs — ship current packages.
RUN apt-get update \
    && apt-get dist-upgrade -y \
    && apt-get install -y --no-install-recommends \
        curl git ca-certificates gnupg2 lsb-release apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# PHP 8.3 from the Sury repo (keyring style), Apache, PostgreSQL — one apt
# pass. Moodle-required PHP extensions per mpd's runtime build.
RUN curl -fsSL https://packages.sury.org/php/apt.gpg \
        | gpg --dearmor -o /usr/share/keyrings/sury-php.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" \
        > /etc/apt/sources.list.d/sury-php.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        apache2 postgresql postgresql-client \
        php8.3-cli php8.3-fpm php8.3-curl php8.3-gd php8.3-intl php8.3-mbstring \
        php8.3-pgsql php8.3-soap php8.3-xml php8.3-zip php8.3-opcache \
    && rm -rf /var/lib/apt/lists/*

# The console's Moodle-side PHP (web endpoints + cli/ scripts); installed
# into the docroot as mdl-demo/ on site install.
COPY php/ /usr/share/mdl-demo/php/

# Optional poster: if assets/poster/ carries a title.html, the console shows one
# extra Tools card (first slot) + its sub-page from these files — a fork/presenter
# customization (conference shout-out, welcome page, …) that leaves the mdl-demo
# identity unchanged. Empty by default (only a README, stripped). See
# assets/poster/README.md.
COPY assets/poster/ /usr/share/mdl-demo/poster/
RUN rm -f /usr/share/mdl-demo/poster/README.md

# Mailpit catches all the demo site's outgoing mail (console → Mail card);
# official release binary. Pinned with checksums — bump both together.
ARG MAILPIT_VERSION=v1.31.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) sha256=076b5ded9a2182842b93e761b9586a1a251445bffe2666f9f22a6dc14470237d ;; \
        arm64) sha256=db3e685ed59d58354a29a4e7bfd0497f050af771a41e122aabdb0bd4fb915952 ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/mailpit.tgz "https://github.com/axllent/mailpit/releases/download/${MAILPIT_VERSION}/mailpit-linux-${arch}.tar.gz"; \
    echo "$sha256  /tmp/mailpit.tgz" | sha256sum -c --quiet; \
    tar -C /usr/local/bin -xzf /tmp/mailpit.tgz mailpit; \
    rm /tmp/mailpit.tgz

# cloudflared for the console's Quick Tunnel button (try.cloudflare.com).
RUN curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" \
        > /etc/apt/sources.list.d/cloudflared.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends cloudflared \
    && rm -rf /var/lib/apt/lists/*

# Moodle's php.ini requirements (fpm + cli), values from mpd's runtime.
RUN for sapi in fpm cli; do \
        printf '%s\n' \
            'max_input_vars = 10000' \
            'upload_max_filesize = 200M' \
            'post_max_size = 206M' \
            'zend.exception_ignore_args = On' \
            > /etc/php/8.3/$sapi/conf.d/99-moodle.ini; \
    done

# Apache: PHP via FPM socket, Moodle 5 router needs rewrite. Port 8082 only
# (8081 is the Go console; both numbers are fixed inside the container).
# The placeholder vhost is swapped for the real Moodle vhost by mdl-demo at
# install time (the docroot depends on the Moodle version's tree layout).
COPY container/apache/placeholder/ /var/www/placeholder/
COPY container/apache/000-placeholder.conf /etc/apache2/sites-available/
RUN a2enmod proxy_fcgi rewrite setenvif \
    && a2dissite 000-default \
    && a2ensite 000-placeholder \
    && sed -i 's/^Listen 80$/Listen 8082/' /etc/apache2/ports.conf \
    && echo 'ServerName localhost' > /etc/apache2/conf-available/servername.conf \
    && a2enconf servername

# Demo-speed tweak from mpd: bounded loss on power cut, no corruption.
# (Deliberately NOT full_page_writes=off — that risks torn pages.)
RUN printf 'synchronous_commit = off\n' \
        > "$(ls -d /etc/postgresql/*/main/conf.d)/demo.conf"

COPY --from=build /out/mudev /out/mdl-demo /usr/bin/

# Local git repos a fork bakes in (bare or plain checkouts dropped into
# assets/repos/) land at /srv/extra/repos FIRST, so the catalogue clone below can
# source from them. Empty by default. Hidden by design; see assets/repos/README.md.
COPY assets/repos/ /srv/extra/repos/
RUN rm -f /srv/extra/repos/README.md

# Recipe + plugin catalogues at mudev's default paths. Shallow, but with .git
# kept so a running container can `git pull` fresh recipes. Each catalogue is
# cloned from a baked local mirror when a fork provides one under assets/repos/
# at the full git URL path minus scheme (assets/repos/github.com/mutms/mdl-recipes
# ↔ https://github.com/mutms/mdl-recipes), so a fully offline image can keep every
# git clone/pull on the local fs; else from the public GitHub catalogue.
RUN for c in mdl-recipes mdl-plugins; do \
        if [ -d "/srv/extra/repos/github.com/mutms/$c" ]; then \
            git clone "/srv/extra/repos/github.com/mutms/$c" "/srv/extra/$c"; \
        else \
            git clone --depth 1 "https://github.com/mutms/$c" "/srv/extra/$c"; \
        fi; \
    done \
    && mkdir -p /srv/projects/demo /srv/data /srv/backups /etc/mdl-demo && chmod 700 /srv/backups

# Pre-bundled site backups: any *.mdb dropped into the repo's assets/backups/
# dir ships in the image, ready to restore from the console — how a fork bakes a
# prepared demo site into its own image (see assets/backups/README.md).
# Deliberately one of the last layers: a fork refreshing its bundled demo
# rebuilds almost nothing.
COPY assets/backups/ /srv/backups/
RUN chmod 700 /srv/backups && find /srv/backups -type f -exec chmod 600 {} +

# Recipe overlay: <vendor>/<stream>/<version>.yaml files in the repo's
# assets/recipes/ dir are merged into the catalogue checkout — forks ship their
# own recipes in the image (see assets/recipes/README.md). The README is
# stripped so the checkout stays clean for `git pull`.
COPY assets/recipes/ /srv/extra/recipes-overlay/
RUN rm -f /srv/extra/recipes-overlay/README.md \
    && cp -r /srv/extra/recipes-overlay/. /srv/extra/mdl-recipes/ \
    && rm -rf /srv/extra/recipes-overlay

# Links the ghcr.io package to the repo (and its README to the package page).
LABEL org.opencontainers.image.source=https://github.com/mutms/mdl-demo \
      org.opencontainers.image.description="Throwaway Moodle/MuTMS demo sites in one command" \
      org.opencontainers.image.licenses=GPL-3.0-or-later

EXPOSE 8081 8082

# mdl-demo init as PID 1: supervises the services, reaps orphans, and turns
# SIGTERM (the default stop signal) into an ordered shutdown.
ENTRYPOINT ["/usr/bin/mdl-demo", "init"]
