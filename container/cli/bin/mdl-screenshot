#!/bin/bash
# Save a PNG of one page of the demo site, seen as a given user. Logs in with a
# single-use link (see mdl-login) and renders with headless Chromium, so no
# password is involved. Needs Chromium: run claude-install first.
#
# Usage: mdl-screenshot [options] [/local/path]
#   /local/path       page to capture, default "/"
#   --user=<name>     Moodle username, default "admin"
#   --size=<W>x<H>    window size, default 1280x1024; the capture is the
#                     window, so raise H to see more of a long page
#   --wait=<ms>       time given to the page's JavaScript, default 5000
#   --out=<file.png>  where to save, default a new file in ~/screenshots/
#
# Prints the path of the PNG. Shows a page as it loads: it cannot click.
set -euo pipefail

USERNAME="admin"
SIZE="1280x1024"
WAIT="5000"
OUT=""
LANDING="/"
for arg in "$@"; do
    case "$arg" in
        --user=*) USERNAME="${arg#--user=}" ;;
        --size=*) SIZE="${arg#--size=}" ;;
        --wait=*) WAIT="${arg#--wait=}" ;;
        --out=*)  OUT="${arg#--out=}" ;;
        -h|--help)
            sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        -*) echo "Unknown option '${arg}'." >&2; exit 1 ;;
        *)  LANDING="$arg" ;;
    esac
done

if [[ ! "$SIZE" =~ ^[0-9]+x[0-9]+$ ]]; then
    echo "--size must look like 1280x1024." >&2
    exit 1
fi
if [[ ! "$WAIT" =~ ^[0-9]+$ ]]; then
    echo "--wait must be a number of milliseconds." >&2
    exit 1
fi
if ! command -v chromium >/dev/null 2>&1; then
    echo "Chromium is not installed: run claude-install first." >&2
    exit 1
fi

if [ -z "$OUT" ]; then
    mkdir -p "$HOME/screenshots"
    SLUG=$(printf '%s' "$LANDING" | sed 's/[?#].*//' | tr -c 'A-Za-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//' | cut -c1-60)
    OUT="$HOME/screenshots/$(date +%Y%m%d-%H%M%S)-${USERNAME}-${SLUG:-home}.png"
else
    OUT=$(realpath -m "$OUT")
    mkdir -p "$(dirname "$OUT")"
fi

URL=$(mdl-login "$USERNAME" "--path=${LANDING}" --internal)

# A throwaway profile: no session outlives the capture. The time limit turns a page
# that never settles into an error, and /dev/shm is too small for Chromium here.
PROFILE=$(mktemp -d)
trap 'rm -rf "$PROFILE"' EXIT
LOG="${PROFILE}/chromium.log"
RC=0
timeout --kill-after=5 60 chromium --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage \
    --no-first-run --hide-scrollbars \
    --user-data-dir="$PROFILE" \
    --window-size="${SIZE/x/,}" \
    --virtual-time-budget="$WAIT" \
    --screenshot="$OUT" "$URL" >"$LOG" 2>&1 || RC=$?
if [ "$RC" != 0 ] || [ ! -s "$OUT" ]; then
    case "$RC" in
        124) echo "Chromium did not finish within 60 seconds." >&2 ;;
        137) echo "Chromium was killed, probably because memory ran out." >&2 ;;
        *)   echo "Chromium did not produce a screenshot (exit $RC)." >&2 ;;
    esac
    # Out of memory looks like anything else, often a hang, so always give the facts:
    # the container's own limit where it has one, else the machine's.
    AVAILABLE=$(awk '/^MemAvailable/ { print int($2 / 1024) }' /proc/meminfo)
    KILLS=$(awk '/^oom_kill / { print $2 }' /proc/vmstat)
    if [ -r /sys/fs/cgroup/memory.events ]; then
        KILLS=$(awk '$1 == "oom_kill" { print $2 }' /sys/fs/cgroup/memory.events)
        MAX=$(cat /sys/fs/cgroup/memory.max)
        if [ "$MAX" != max ]; then
            AVAILABLE=$(( (MAX - $(cat /sys/fs/cgroup/memory.current)) / 1048576 ))
        fi
    fi
    echo "Unused memory: ${AVAILABLE} MB. Processes killed for lack of memory: ${KILLS}." >&2
    if [ "${KILLS:-0}" != 0 ]; then
        echo "This container is probably short of memory, so give it more." >&2
    fi
    grep -v 'dbus/' "$LOG" | tail -n 10 >&2
    exit 1
fi

echo "$OUT"
