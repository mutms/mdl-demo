#!/bin/bash
# Run PHP inside the demo's Moodle. config.php is loaded as a CLI script first,
# so $CFG, $DB and the whole Moodle API are there.
#
# Usage: mdl-php [--user=<username>] <code>
#        mdl-php [--user=<username>] <file.php> [args...]
#        mdl-php [--user=<username>] -          (code from stdin)
#   --user   run as this Moodle user; without it there is no user, as in any
#            Moodle CLI script
#
# Examples:
#   mdl-php 'echo $CFG->release, "\n";'
#   mdl-php 'print_r($DB->get_records("user", null, "id", "id, username"));'
#   mdl-php --user=admin 'var_dump(is_siteadmin());'
#
# Code may leave out "<?php" and the last semicolon. A file needs "<?php".
# This writes to the real site database: nothing is rolled back.
set -euo pipefail

TREE=/srv/projects/demo
RUNNER=/usr/share/mdl-demo/cli/php/run.php

USERNAME=""
while [ $# -gt 0 ]; do
    case "$1" in
        --user=*) USERNAME="${1#--user=}"; shift ;;
        -h|--help)
            sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) break ;;
    esac
done

if [ $# -lt 1 ]; then
    echo "Usage: mdl-php [--user=<username>] <code> | <file.php> [args...] | -" >&2
    exit 1
fi
if [ ! -f "$TREE/config.php" ]; then
    echo "No demo site is installed: install one from the console first." >&2
    exit 1
fi

SOURCE="$1"
shift
if [ "$SOURCE" = "-" ]; then
    MODE="code"
    SOURCE=$(cat)
elif [ -f "$SOURCE" ]; then
    MODE="file"
    SOURCE=$(realpath "$SOURCE")
else
    MODE="code"
fi

# A pasted snippet often starts with the open tag; eval() must not see it.
if [ "$MODE" = "code" ]; then
    SOURCE="${SOURCE#"${SOURCE%%[![:space:]]*}"}"
    SOURCE="${SOURCE#<?php}"
fi

exec php "$RUNNER" "$TREE" "$USERNAME" "$MODE" "$SOURCE" "$@"
